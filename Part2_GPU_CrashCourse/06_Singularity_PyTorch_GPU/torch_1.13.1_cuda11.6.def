Bootstrap: docker
From: pytorch/pytorch:1.13.1-cuda11.6-cudnn8-runtime

%post
    apt-get update && apt-get install -y \
        git ffmpeg libsndfile1-dev sox \
        build-essential python3-dev libffi-dev \
        && rm -rf /var/lib/apt/lists/*

    pip install pip==24.0
    pip install numpy==1.24.4
    pip install git+https://github.com/facebookresearch/fairseq@v0.12.2
    pip install torch==1.13.1 torchaudio==0.13.1 tensorboard tensorboardX \
        matplotlib librosa pandas scikit-learn scipy seaborn \
        omegaconf==2.0.6 hydra-core==1.0.7 obspy>=1.3.1 seisbench==0.4.1

%environment
    export PYTHONUNBUFFERED=1

%runscript
    exec /bin/bash
